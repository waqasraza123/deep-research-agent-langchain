MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-real-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_S=60
OPENAI_MAX_RETRIES=1
OPENAI_MAX_TOKENS=200

MAX_PAGE_CHARS=15000
HTTP_TIMEOUT_S=20

# Source discovery is offline/disabled by default.
# Set provider to mock for deterministic local development; static results can also be
# passed per request through SourceDiscoverySettings.static_results.
SOURCE_DISCOVERY_ENABLED=false
SOURCE_DISCOVERY_PROVIDER=disabled
SOURCE_DISCOVERY_MAX_QUERIES=8
SOURCE_DISCOVERY_MAX_CANDIDATES_PER_QUERY=5
SOURCE_DISCOVERY_MAX_SELECTED_SOURCES=3
SOURCE_DISCOVERY_ALLOW_SECONDARY_SOURCES=true
SOURCE_DISCOVERY_ALLOW_FORUMS=false
SOURCE_DISCOVERY_REQUIRE_PRIMARY=true
