MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-real-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_S=60
OPENAI_MAX_RETRIES=1
OPENAI_MAX_TOKENS=200

MAX_PAGE_CHARS=15000
HTTP_TIMEOUT_S=20

# Backend intelligence controls. Defaults are offline-safe: no live search and no embeddings.
PROTOCOL_SELECTION_ENABLED=true
INTELLIGENCE_PROFILE=balanced_research
DOCUMENT_INTELLIGENCE_ENABLED=true
CHUNK_MAX_CHARS=3200
CHUNK_OVERLAP_CHARS=300
RETRIEVAL_ENABLED=true
EMBEDDING_PROVIDER=disabled
CONTEXT_PACK_MAX_CHARS=11000
VERIFICATION_ENABLED=true
VERIFICATION_GATE_ENABLED=false
MAX_VERIFICATION_TASKS=12
CONFIDENCE_THRESHOLD_FOR_REVIEW=0.55

# Source discovery is offline/disabled by default.
# Set provider to mock for deterministic local development; static results can also be
# passed per request through SourceDiscoverySettings.static_results.
SOURCE_DISCOVERY_ENABLED=false
SOURCE_DISCOVERY_PROVIDER=disabled
MAX_DISCOVERY_QUERIES=8
MAX_SELECTED_DISCOVERED_SOURCES=3
SOURCE_DISCOVERY_MAX_QUERIES=8
SOURCE_DISCOVERY_MAX_CANDIDATES_PER_QUERY=5
SOURCE_DISCOVERY_MAX_SELECTED_SOURCES=3
SOURCE_DISCOVERY_ALLOW_SECONDARY_SOURCES=true
SOURCE_DISCOVERY_ALLOW_FORUMS=false
SOURCE_DISCOVERY_REQUIRE_PRIMARY=true
